[Desktop Entry]
Type=Application
Name=GP Client
GenericName=VPN Client
GenericName[nl]=VPN-client
GenericName[fy]=VPN-client
Comment=Connect to GlobalProtect VPN (smart-card / certificate)
Comment[nl]=Verbind met GlobalProtect-VPN (smartcard / certificaat)
Comment[fy]=Ferbyn mei GlobalProtect-VPN (smartcard / sertifikaat)
Exec=gp-client %u
Icon=io.github.techneut92.GPClient
Terminal=false
Categories=Network;Security;
Keywords=VPN;GlobalProtect;OpenConnect;PKCS11;
StartupNotify=true
StartupWMClass=io.github.techneut92.GPClient
# Handle the GlobalProtect browser-SSO callback so system-browser sign-in can
# return the auth cookie to the running app (see saml.rs).
MimeType=x-scheme-handler/globalprotectcallback;
