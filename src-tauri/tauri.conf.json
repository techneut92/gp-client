{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GP Client",
  "version": "0.1.0",
  "identifier": "io.github.techneut92.GPClient",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "GP Client",
        "width": 460,
        "height": 822,
        "minWidth": 460,
        "minHeight": 822,
        "maxWidth": 460,
        "maxHeight": 822,
        "resizable": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
