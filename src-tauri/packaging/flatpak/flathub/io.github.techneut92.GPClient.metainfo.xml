<component type="desktop-application">
  <id>io.github.techneut92.GPClient</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-Proprietary</project_license>
  <name>GP Client</name>
  <summary>Connect to GlobalProtect VPN with smart cards</summary>

  <description>
    <p>
      A graphical client for GlobalProtect VPN. Sign in with a smart card /
      PKCS#11 certificate (such as a YubiKey PIV), SAML single sign-on, or a
      username and password.
    </p>
    <p>
      Save multiple connections in an encrypted vault, unlock it from your
      keyring, and manage the VPN from a system-tray icon with desktop
      notifications.
    </p>
    <p>
      The privileged backend (gpservice) is installed separately as a host
      package and reached over D-Bus; the in-app screen guides that install.
    </p>
  </description>

  <launchable type="desktop-id">io.github.techneut92.GPClient.desktop</launchable>

  <!--
    Flathub REQUIRES at least one reachable screenshot. Add PNGs under
    docs/screenshots/ in the repo (or host them anywhere stable) and point these
    URLs at them; `appstreamcli validate` will fail until they resolve.
  -->
  <screenshots>
    <screenshot type="default">
      <caption>Connect to a GlobalProtect gateway</caption>
      <image>https://raw.githubusercontent.com/techneut92/gp-client/main/docs/screenshots/connect.png</image>
    </screenshot>
    <screenshot>
      <caption>Manage saved connections in an encrypted vault</caption>
      <image>https://raw.githubusercontent.com/techneut92/gp-client/main/docs/screenshots/manager.png</image>
